      ],
      "id": "e0f75de0-d4bb-46fe-ab4c-712ef8b5bc99",
      "name": "Limit NOS 20"
    },
    {
      "parameters": {
        "jsCode": "let text = '';\nfor (const item of $input.all()) {\n  const bron = item.json.bron || (item.json.link?.includes('ad.nl') ? 'AD' : 'NOS');\n  const titel = item.json.title;\n  const datum = item.json.isoDate || item.json.pubDate;\n  const beschrijving = item.json.contentSnippet || item.json.content || '';\n  text += `Bron: ${bron}\\nTitel: ${titel}\\nDatum: ${datum}\\nBeschrijving: ${beschrijving}\\n\\n`;\n}\nreturn [{ json: { newsText: text } }];"
      },
      "type": "n8n-nodes-base.code",
