        "jsCode": "const posts = ($input.first().json.data || [])\n  .filter(p => p.link && !p.nsfw && !p.is_ad)\n  .slice(0, 5);\nif (posts.length === 0) {\n  throw new Error('Imgur returned no usable posts');\n}\nconst lines = posts.map((p, i) => `${i + 1}. ${p.title || 'Untitled'} - ${p.link}`);\nconst content = `☀️ **Your daily Imgur**\\n${lines.join('\\n')}`;\nreturn [{ json: { content: content.slice(0, 2000) } }];"
      }
